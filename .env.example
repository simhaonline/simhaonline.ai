# Simha Online platform secrets — copy to .env and fill in
# NEVER commit .env

POSTGRES_USER=simha
POSTGRES_PASSWORD=change_me_strong
POSTGRES_DB=simhaonline

JWT_SECRET=change_me_to_64_random_hex
OAUTH_ENCRYPTION_KEY=change_me_to_64_random_hex   # 32-byte hex — encrypts provider credentials at rest
SESSION_TTL_HOURS=24
SESSION_COOKIE_DOMAIN=.simhaonline.ai

# Nightly pg_dump backups (worker job, keeps last 7 in ./backups)
BACKUP_INTERVAL=86400

# Stripe (payments). Leave STRIPE_SECRET_KEY empty to use manual bank-transfer
# invoicing instead. Webhook endpoint: /billing/webhook (Plesk proxies /billing → 8081).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Upstream routing defaults
COOLDOWN_SECONDS=60
USAGE_THRESHOLD=0.9
MODEL_REFRESH_INTERVAL=300
STATUS_SNAPSHOT_INTERVAL=60

# SMTP (status subscriptions + signup notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@simhaonline.ai

# Bootstrap admin (created on first control-plane start when users table is empty)
ADMIN_EMAIL=admin@simhaonline.ai
ADMIN_PASSWORD=

# Public URLs
NEXT_PUBLIC_SITE_URL=https://simhaonline.ai
OAUTH_CALLBACK_BASE=https://api.simhaonline.ai/api/oauth/callback

# Legacy migration
LEGACY_SQLITE_PATH=/data/simha_edge.db
# Public IPv4 of THIS server (docker ports bind here so the remote Plesk can proxy)
PROXY_BIND_IP=152.53.67.111
